{
  "$schema": "../gen/schemas/config-schema.json",
  "productName": "VibeFlow",
  "version": "0.3.4",
  "identifier": "com.derjanniku.vibeflow",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ui",
    "beforeBuildCommand": "npm run build --prefix ui"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "title": "VibeFlow",
        "label": "main",
        "width": 900,
        "height": 600,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "resizable": true
      },
      {
        "title": "VibeFlow Overlay",
        "label": "overlay",
        "width": 200,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "x": 20,
        "y": 20
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ggml-base.en.bin"
    ],
    "targets": "all"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DerJanniku/VibeFlow/releases/latest/download/latest.json"
      ],
      "pubkey": "RWRSK/I5XiqAT3Eg5Mqvz90v3Tn5rLDPKYLmNdjbM1+Jc4RA JqgsRaBpZH"
    }
  }
}
